gk, add_obso, add_pre_shot_gk_context, add_team_shape,\\n)\\n\\n\\ndef _frames():\\n    return pd.DataFrame([\\n        dict(\\n            game_id=1, period_id=1, frame_id=1, time_seconds=1.0, frame_rate=25.0,\\n            player_id=7, team_id=1, is_ball=False, is_goalkeeper=True, x=5.0, y=34.0, z=0.0,\\n            speed=0.0, speed_source=\"native\", ball_state=\"alive\",\\n            team_attacking_direction=\"ltr\", confidence=None, visibility=None,\\n            source_provider=\"test\",\\n        )\\n    ])\\n\\n\\ndef test_mirror():\\n    actions = pd.DataFrame({\"game_id\": [1], \"period_id\": [1], \"action_id\": [0]})\\n    frames = _frames()\\n    add_defensive_line(actions, frames)\\n    add_ghost_gk(actions, frames, home_team_id=1)\\n    add_obso(actions, frames)\\n    add_pre_shot_gk_context(actions, frames)\\n    add_team_shape(actions, frames)\\n]":0.0010323610000568806,"tests/scripts/test_audit_velocity_fixtures.py::test_the_two_probe_arms_differ_ONLY_in_the_vector":0.01058272400007354,"tests/scripts/test_build_gkdv_arm_values.py::test_a_COUNTING_pass_over_finished_partitions_is_refused":0.03300644499995542,"tests/scripts/test_build_gkdv_arm_values.py::test_a_worker_manifest_records_the_keys_it_covered":0.013712072999851443,"tests/scripts/test_build_gkdv_arm_values.py::test_aggregate_of_an_empty_dir_is_empty_not_a_crash":0.000565043000165133,"tests/scripts/test_build_gkdv_arm_values.py::test_attacking_team_is_None_when_only_the_defenders_are_present":0.0006343079999169277,"tests/scripts/test_build_gkdv_arm_values.py::test_attacking_team_is_the_non_defending_outfield_team":0.001234745000147086,"tests/scripts/test_build_gkdv_arm_values.py::test_attacking_team_resolution_is_dtype_safe":0.0012668549999261813,"tests/scripts/test_build_gkdv_arm_values.py::test_conservation_is_reported_FALSE_when_it_genuinely_fails":0.0006821409999702155,"tests/scripts/test_build_gkdv_arm_values.py::test_corpus_manifest_AGGREGATES_every_partition":0.0010091440000223884,"t